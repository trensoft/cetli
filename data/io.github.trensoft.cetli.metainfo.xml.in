<component type="desktop-application">
  <id>io.github.trensoft.cetli</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Cetli</name>
  <summary>Small notes on the desktop that sync between your computers</summary>
  <description>
    <p>cetli keeps short notes in small windows on the GNOME desktop. Every note is one plain file in a folder, so the folder can be kept in step between your computers with a tool such as Syncthing.</p>
    <p>If two computers change the same note before they meet, cetli keeps both versions and shows the second one as a note of its own.</p>
  </description>
  <developer id="hu.trensoft">
    <name>TrenSoft</name>
  </developer>
  <url type="homepage">https://github.com/trensoft/cetli</url>
  <url type="bugtracker">https://github.com/trensoft/cetli/issues</url>
  <launchable type="desktop-id">io.github.trensoft.cetli.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Utility</category>
  </categories>
  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@"/>
  </releases>
</component>
