msgstr "Nincs mentve: a másik változatot nem sikerült megőrizni"

#: app/strings.js
msgid "Not saved: the other version could not be kept (disk full?)"
msgstr ""
"Nincs mentve: a másik változatot nem sikerült megőrizni (megtelt a lemez?)"

#: app/strings.js
msgid "Not saved: the file could not be written"
msgstr "Nincs mentve: a fájlt nem sikerült megírni"

#: app/strings.js
